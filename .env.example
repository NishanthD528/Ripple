# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Groq (llama-3.3-70b-versatile) ----
# Free tier: 30 req/min, 1,000 req/day, 12K tokens/min.
GROQ_API_KEY=your-groq-key

# ---- Resend ----
# Free tier: 3,000/mo, 100/day. Without a verified domain, delivers only to your own inbox.
RESEND_API_KEY=your-resend-key
# The From address. Use onboarding@resend.dev until a domain is verified.
RESEND_FROM="Ripple <onboarding@resend.dev>"

# ---- Stripe (test mode) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

# ---- App ----
# Public base URL of the deployment. Used for auth redirects and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret protecting the ingest function's manual trigger endpoint.
CRON_SECRET=change-me-to-a-long-random-string
